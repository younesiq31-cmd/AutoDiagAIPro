<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AutoInspect AI</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

<header>

<div class="logo">

<img src="assets/logo.png">

<h1>AutoInspect AI</h1>

</div>

<nav>

<button id="languageBtn">العربية</button>

<button id="themeBtn">🌙</button>

</nav>

</header>

<section class="hero">

<h2>منصة الفحص الذكي للمركبات</h2>

<p>

ذكاء اصطناعي لفحص المركبات وتحليل الهيكل واكتشاف الأضرار.

</p>

</section>

<section class="vehicle-card">

<h2>بيانات المركبة</h2>

<select id="make"></select>

<select id="model"></select>

<select id="year"></select>

<input
type="text"
id="vin"
maxlength="17"
placeholder="VIN">

<div class="buttons">

<button id="scanVIN">

قراءة VIN

</button>

<button id="scanBarcode">

QR / Barcode

</button>

</div>

</section>

<section class="photos">

<h2>صور المركبة</h2>

<div id="photoPreview"></div>

<input
type="file"
id="galleryInput"
multiple
accept="image/*">

<input
type="file"
id="cameraInput"
accept="image/*"
capture="environment">

<div class="buttons">

<button onclick="galleryInput.click()">

اختيار الصور

</button>

<button onclick="cameraInput.click()">

فتح الكاميرا

</button>

</div>

</section>

<section class="inspection">

<h2>نتائج الفحص</h2>

<div class="score">

<div>

<p>Health</p>

<h1 id="health">--</h1>

</div>

<div>

<p>Damage</p>

<h1 id="damage">--</h1>

</div>

<div>

<p>Confidence</p>

<h1 id="confidence">--</h1>

</div>

</div>

<button id="inspectBtn">

بدء الفحص الذكي

</button>

</section>

<section class="damageMap">

<h2>خريطة الهيكل</h2>

<img
src="assets/car.png"
id="carMap">

<canvas id="damageCanvas"></canvas>

</section>

<section class="history">

<h2>سجل الفحوصات</h2>

<div id="historyList"></div>

</section>

<footer>

<p>

AutoInspect AI © 2026

</p>

</footer>

<script src="config.js"></script>

<script src="database.js"></script>

<script src="camera.js"></script>

<script src="barcode-scanner.js"></script>

<script src="vin-scanner.js"></script>

<script src="speech.js"></script>

<script src="ai-engine.js"></script>

<script src="report.js"></script>

<script src="storage.js"></script>

<script src="app.js"></script>

</body>

</html>
